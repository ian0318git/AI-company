# AI Embedded Company — Environment Configuration

# Database
DATABASE_URL=sqlite+aiosqlite:///data/ai_embedded_company.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/ai_embedded_company

# API Server
API_HOST=127.0.0.1
API_PORT=8765

# MCP Server
MCP_SERVER_NAME=ai-embedded-company

# Paths
DATA_DIR=~/.claude/data/ai-embedded-company
AGENTS_DIR=~/.claude/agents
HOOKS_DIR=~/.claude/hooks/ai-embedded-company

# Embedded Hardware Defaults
DEFAULT_BOARD=m5stack-core-s3
DEFAULT_PORT=/dev/ttyACM0
DEFAULT_BAUDRATE=115200
PLATFORMIO_BAUD=921600

# Logging
LOG_LEVEL=INFO
